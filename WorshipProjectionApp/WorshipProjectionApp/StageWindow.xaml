<Window x:Class="WorshipProjectionApp.StageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEBCR II Setúbal - Ecrã do Louvor"
        Background="Black"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Ecrã do grupo de louvor: só a letra atual, grande, sobre fundo preto -->
    <Grid Background="Black">
        <Viewbox x:Name="StageViewbox" Stretch="Uniform" StretchDirection="DownOnly" Margin="60">
            <TextBlock x:Name="TxtStage"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontWeight="Bold"
                       FontSize="96"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="1700"/>
        </Viewbox>
    </Grid>
</Window>
