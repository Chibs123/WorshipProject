<Window x:Class="WorshipProjectionApp.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Canções Estilo PowerPoint" 
        Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#060A12" Padding="14,6,6,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <TextBlock Text="🎵 Editor de Apresentação (Slides)" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOPO: INFORMAÇÕES DA MÚSICA -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Título da Canção:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTitle" Style="{DynamicResource DarkTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Autor / Artista:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtArtist" Style="{DynamicResource DarkTextBox}"/>
                </StackPanel>
            </Grid>

            <!-- CENTRO: EDITOR POWERPOINT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA ESQUERDA: LISTA DE SLIDES -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="➕ Novo Slide" Click="BtnAddSlide_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="🗑️ Apagar" Click="BtnRemoveSlide_Click" Style="{DynamicResource DangerButton}" Padding="12,6"/>
                        </StackPanel>

                        <ListBox x:Name="LstSlidesEditor" SelectionChanged="LstSlidesEditor_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <!-- 1. Limpa o estilo do contentor (sem bordas duplas nem paddings fantasmas) -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- 2. O Cartão em si: Gere a cor, o hover e a seleção -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Adicionado MinHeight="60" para manter a estrutura mesmo sem texto -->
                                    <Border x:Name="SlideCard" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,4,8" MinHeight="60">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" FontSize="12" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- MOSTRA O ICON SE TIVER FUNDO -->
                                            <TextBlock Text="🖼️" Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12"/>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="SlideCard" Property="Background" Value="#1A2538"/>
                                            <Setter TargetName="SlideCard" Property="BorderBrush" Value="#3B4D71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="SlideCard" Property="Background" Value="#24344D"/>
                                            <Setter TargetName="SlideCard" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- COLUNA DIREITA: EDIÇÃO DO SLIDE SELECIONADO -->
                <Border x:Name="EditorPanel" Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Nome do Slide (ex: Verso 1, Coro):" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSlideHeader" Style="{DynamicResource DarkTextBox}" Margin="10,0,0,0" TextChanged="TxtSlideContent_TextChanged"/>
                        </DockPanel>

                        <TextBox x:Name="TxtSlideContent" Grid.Row="1" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="16" Padding="14" TextChanged="TxtSlideContent_TextChanged"/>

                        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock Text="Fundo Dinâmico (da Galeria):" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                                <Button Content="Limpar Fundo" Click="BtnClearBackground_Click" Style="{DynamicResource DangerButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>

                                <!-- COMBOBOX COM AS MINIATURAS VISUAIS -->
                                <ComboBox x:Name="CmbBackgrounds" SelectionChanged="CmbBackgrounds_SelectionChanged" VerticalContentAlignment="Center" Height="52">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="60" Height="40" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                                    <!-- A Miniatura do Fundo -->
                                                    <Image Source="{Binding OptimizedThumbnail, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="🎬 Vídeo" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" Foreground="#EF4444" FontSize="10"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- FUNDO: BOTÕES DE GUARDAR -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Cancelar" Click="BtnCancel_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0"/>
                    <Button Content="Guardar Apresentação" Click="BtnSave_Click" Style="{DynamicResource GoldButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>