<Window x:Class="WorshipProjectionApp.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Canções - IEBCR II Setúbal" 
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#060A12" Padding="14,6,6,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <TextBlock Text="🎵 Editor de Letras &amp; Estrofes" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Título da Canção:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTitle" Style="{DynamicResource DarkTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Autor / Artista:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtArtist" Style="{DynamicResource DarkTextBox}"/>
                    </StackPanel>

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="Letra (separa estrofes com linha em branco ou [Verso], [Coro]):" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLyrics" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Cancelar" Click="BtnCancel_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0"/>
                    <Button Content="Guardar Canção" Click="BtnSave_Click" Style="{DynamicResource GoldButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>