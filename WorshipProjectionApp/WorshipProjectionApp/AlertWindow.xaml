<Window x:Class="WorshipProjectionApp.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avisos &amp; Cronómetro de Culto" 
        Height="360" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título Customizada -->
        <Border Grid.Row="0" Background="#060A12" Padding="14,6,6,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <TextBlock Text="📢 Avisos &amp; Controlo de Tempo" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Mensagem de Aviso (ex: Berçário 12, Matrícula 00-AA-00):" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAlertMessage" Style="{DynamicResource DarkTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Opções de Hora / Cronómetro:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbNone" Content="Apenas texto (sem hora)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbClock" Content="Mostrar Relógio Atual (HH:mm)" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="RbCountdown" Content="Contagem Decrescente:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtMinutes" Text="35" Width="45" Style="{DynamicResource DarkTextBox}" Margin="8,0,4,0" TextAlignment="Center"/>
                        <TextBlock Text="minutos" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <Button Content="Ocultar Aviso" Click="BtnHide_Click" Style="{DynamicResource DangerButton}" DockPanel.Dock="Left"/>
                <Button Content="Projetar Aviso" Click="BtnShow_Click" Style="{DynamicResource GoldButton}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>