<Window x:Class="WorshipProjectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IEBCR II Setúbal - Sistema de Projeção Multimédia" 
        Height="760" Width="1220" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        FontFamily="Segoe UI">

    <!-- Configuração da Barra de Título Integrada -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Paleta Dark Mode Eclesiástica -->
        <SolidColorBrush x:Key="BgCanvas" Color="#0B0F19"/>
        <SolidColorBrush x:Key="PanelBg" Color="#162032"/>
        <SolidColorBrush x:Key="CardBg" Color="#101726"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A384F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentGoldHover" Color="#E5C158"/>
        <SolidColorBrush x:Key="ButtonNeutral" Color="#24344D"/>
        <SolidColorBrush x:Key="ButtonNeutralHover" Color="#334668"/>

        <!-- ESTILOS DE BOTÕES COM ANIMAÇÕES SUAVES -->

        <!-- Estilo Botão Dourado -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#D4AF37"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0B0F19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#E5C158" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#D4AF37" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botão Neutro Escuro -->
        <Style x:Key="NavyButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#24344D"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#334668" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#24344D" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botão Perigo (Vermelho) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#991B1B"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#B91C1C" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#991B1B" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botões de Janela -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24344D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowNavButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E11D48"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollBar Moderna e Minimalista -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3394A3B8" CornerRadius="3" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caixa de Pesquisa -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Template Dark Completo para ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" 
                              Focusable="False" 
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" 
                                    Background="#101726" 
                                    BorderBrush="{StaticResource BorderDark}" 
                                    BorderThickness="1" 
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow" 
                                          Grid.Column="1" 
                                          Fill="{StaticResource AccentGold}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#162032"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter x:Name="ContentSite" 
                                  IsHitTestVisible="False" 
                                  Content="{TemplateBinding SelectionBoxItem}" 
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                  Margin="10,0,28,0" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Left"/>

                <Popup x:Name="Popup" 
                       Placement="Bottom" 
                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                       AllowsTransparency="True" 
                       Focusable="False" 
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown" 
                          SnapsToDevicePixels="True" 
                          MinWidth="{TemplateBinding ActualWidth}" 
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" 
                                Background="#101726" 
                                BorderBrush="{StaticResource BorderDark}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Margin="0,2,0,0">
                            <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#101726"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24344D"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abas -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#101726"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderDark}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabContent" 
                                              ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#24344D"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C273C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Items -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24344D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2538"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabeçalho -->
            <RowDefinition Height="*"/>
            <!-- Corpo (Grelha Principal) -->
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="#060A12" Padding="14,6,8,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">

                <!-- ESQUERDA/CENTRO: Botões de Estado -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">

                    <!-- 1. Botão LIVE -->
                    <Button x:Name="BtnModeLive" Content="LIVE" Click="BtnModeLive_Click" Style="{StaticResource NavyButton}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Transmitir (F5)"/>

                    <!-- 2. Botão LOGO -->
                    <Button x:Name="BtnModeLogo" Content="LOGO" Click="BtnModeLogo_Click" Style="{StaticResource NavyButton}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Clique com o Botão Direito para definir a imagem/vídeo (F6)!">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Definir ficheiro de Logo..." Click="MenuSetLogo_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 3. Botão CLEAR -->
                    <Button x:Name="BtnModeClear" Content="CLEAR" Click="BtnModeClear_Click" Style="{StaticResource NavyButton}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Limpar Ecrã (Esc)"/>

                    <!-- 4. Botão INFORMAÇÕES (Apenas Ícone) -->
                    <Button Click="BtnOpenAlerts_Click" Style="{StaticResource NavyButton}" Margin="0,0,0,0" Padding="12,6" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Informações e Alertas">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE783;" FontSize="15" VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>

                <!-- DIREITA: Controlos da Janela -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Click="BtnMinimize_Click" Style="{StaticResource WindowNavButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE921;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnMaximize_Click" Style="{StaticResource WindowNavButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE922;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnClose_Click" Style="{StaticResource WindowCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- DIREITA: Menu Ferramentas (Apenas Ícone) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <MenuItem Foreground="{StaticResource TextPrimary}" Background="{StaticResource ButtonNeutral}" Padding="12,6" FontWeight="Medium" ToolTip="Ferramentas do Sistema">
                            <MenuItem.Header>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="15" VerticalAlignment="Center"/>
                            </MenuItem.Header>
                            <MenuItem Header="Personalizar Layout (Lego)" Click="BtnOpenLayoutConfig_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Definições de Projeção" Click="BtnOpenSettings_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Importar EasyWorship" Click="BtnImportEasyWorship_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Importar Bíblia (SQLite)" Click="BtnImportBible_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CORPO PRINCIPAL COM MATRIZ PROPORCIONAL -->
        <Grid x:Name="MainColumnsGrid" Grid.Row="1" Margin="14,12,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <!-- Coluna 0: Live + Programação -->
                <ColumnDefinition Width="1.5*"/>
                <!-- Coluna 1: Slides/Letras (Mais larga) -->
                <ColumnDefinition Width="1.5*"/>
                <!-- Coluna 2: Recursos/Bíblia (Mais larga) -->
                <ColumnDefinition Width="1.1*"/>
                <!-- Coluna 3: Equipa de Louvor -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Linha 0: Ajusta-se à altura da miniatura -->
                <RowDefinition Height="*"/>
                <!-- Linha 1: Ocupa o resto do ecrã para baixo -->
            </Grid.RowDefinitions>

            <!-- 1. PAINEL: EM DIRETO (Canto Superior Esquerdo | Col 0, Row 0) -->
            <Border x:Name="PanelLive" Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="180">
                    <Border Width="320" Height="180" Background="Black" CornerRadius="6" ClipToBounds="True" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <Grid>
                            <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" IsMuted="True" MediaEnded="PreviewVideo_MediaEnded"/>
                            <Image x:Name="PreviewBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Viewbox Margin="14" Stretch="Uniform">
                                <TextBlock x:Name="TxtPreview" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.95"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>
                            <!-- Badge EM DIRETO -->
                            <Border x:Name="BadgeLiveBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC060A12" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="4" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="BadgeLiveDot" Width="7" Height="7" Fill="#EF4444" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="BadgeLiveText" Text="EM DIRETO" Foreground="#EF4444" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>
            </Border>

            <!-- 2. PAINEL: PROGRAMAÇÃO (Canto Inferior Esquerdo | Col 0, Row 1) -->
            <Border x:Name="PanelSchedule" Grid.Column="0" Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" Foreground="{StaticResource AccentGold}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Programação" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="BtnScheduleMoveUp_Click" Style="{StaticResource NavyButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="Mover para Cima">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74A;" FontSize="12"/>
                            </Button>
                            <Button Click="BtnScheduleMoveDown_Click" Style="{StaticResource NavyButton}" Padding="6,2" Margin="0,0,8,0" ToolTip="Mover para Baixo">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74B;" FontSize="12"/>
                            </Button>
                            <Button Click="BtnScheduleRemove_Click" Style="{StaticResource DangerButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="Remover (Del)">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LstSchedule" SelectionChanged="LstSchedule_SelectionChanged" KeyDown="LstSchedule_KeyDown" AllowDrop="True" Drop="LstSchedule_Drop" DragOver="LstSchedule_DragOver" PreviewMouseMove="LstSchedule_PreviewMouseMove" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,4,10,4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.2"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 3. PAINEL: SLIDES ATIVOS (Centro Esquerda | Col 1, Ocupa 2 Linhas) -->
            <Border x:Name="PanelSlides" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel>
                    <TextBlock x:Name="TxtSelectedSongTitle" DockPanel.Dock="Top" Text="Nenhum item selecionado" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" Margin="4,0,0,10"/>
                    <ListBox x:Name="LstSlides" SelectionChanged="LstSlides_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,4,10,6" Background="{StaticResource CardBg}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="4" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 4. PAINEL: RECURSOS (Centro Direita | Col 2, Ocupa 2 Linhas) -->
            <Border x:Name="PanelResources" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                <TabControl>
                    <!-- Aba Músicas -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D6;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Músicas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,8,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchSong" Grid.Column="0" Style="{StaticResource SearchTextBox}" TextChanged="TxtSearchSong_TextChanged"/>
                                <Button Grid.Column="1" Click="BtnNewSong_Click" Style="{StaticResource GoldButton}" Padding="8,4" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nova" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListBox x:Name="LstSongs" DisplayMemberPath="Title" SelectionChanged="LstSongs_SelectionChanged" PreviewMouseMove="LstSongs_PreviewMouseMove" BorderThickness="0" Background="Transparent"/>
                        </DockPanel>
                    </TabItem>

                    <!-- Aba Bíblia -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE82D;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Bíblia" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Ex: jo 3:16, sl 23 ou palavra" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchBible" Grid.Column="0" Style="{StaticResource SearchTextBox}" Margin="0,0,4,0" KeyDown="TxtSearchBible_KeyDown"/>
                                <ComboBox x:Name="CmbBibleVersion" Grid.Column="1" SelectionChanged="CmbBibleVersion_SelectionChanged"/>
                            </Grid>
                            <ListBox x:Name="LstBibleResults" DisplayMemberPath="Reference" SelectionChanged="LstBibleResults_SelectionChanged" PreviewMouseMove="LstBibleResults_PreviewMouseMove" BorderThickness="0" Background="Transparent"/>
                        </DockPanel>
                    </TabItem>

                    <!-- Aba Fundos -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE91B;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Fundos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,8,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnImportBackground_Click" Style="{StaticResource GoldButton}" Margin="0,0,6,0" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Importar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="BtnClearBackground_Click" Style="{StaticResource NavyButton}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE894;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Limpar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RbFilterAll" Content="Todos" IsChecked="True" Checked="BgFilter_Changed" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbFilterVideos" Content="Vídeos" Checked="BgFilter_Changed" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbFilterImages" Content="Fotos" Checked="BgFilter_Changed" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ListBox x:Name="LstBackgrounds" SelectionChanged="LstBackgrounds_SelectionChanged" AllowDrop="True" Drop="LstBackgrounds_Drop" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Width="105" Height="75" Margin="4,4,8,8" ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border Background="#B21E293B" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,2" CornerRadius="0,0,0,4">
                                                    <TextBlock Text="{Binding IsVideo, Converter={x:Null}}" Foreground="{StaticResource AccentGold}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#CC0A0F19" VerticalAlignment="Bottom" Padding="4,2">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 5. PAINEL: GRUPO DE LOUVOR (Extrema Direita | Col 3, Ocupa 2 Linhas) -->
            <Border x:Name="PanelWorshipTeam" Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE1D6;" Foreground="{StaticResource AccentGold}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Equipa" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Mic/Retorno" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbPresetMembers" Height="30" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="Medium"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Click="BtnAddTeamMember_Click" Style="{StaticResource GoldButton}" Padding="10,4" Margin="6,0,0,0" ToolTip="Adicionar Membro">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <ListBox x:Name="LstActiveTeam" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,4,10,4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                                    </Border.Effect>
                                    <DockPanel LastChildFill="True">
                                        <Button Click="BtnEditTeamMember_Click" DockPanel.Dock="Right" Focusable="False" Background="Transparent" Foreground="#D4AF37" BorderThickness="0" FontSize="13" Width="30" Height="30" Cursor="Hand" ToolTip="Editar">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;"/>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Microphone}" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding InEarReturn}" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                            <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>