<Window x:Class="WorshipProjectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IEBCR II Setúbal - Sistema de Projeção Multimédia" 
        Height="760" Width="1220" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainColumnsGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.4"
                                     DecelerationRatio="0.8"/>
                    <ThicknessAnimation Storyboard.TargetName="MainColumnsGrid"
                                        Storyboard.TargetProperty="Margin"
                                        From="14,30,14,14" To="14,12,14,14" 
                                        Duration="0:0:0.5" DecelerationRatio="0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgCanvas" Color="#0B0F19"/>
        <SolidColorBrush x:Key="PanelBg" Color="#162032"/>
        <SolidColorBrush x:Key="CardBg" Color="#101726"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A384F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ButtonNeutral" Color="#24344D"/>
        <SolidColorBrush x:Key="ButtonNeutralHover" Color="#334668"/>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="#0B0F19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonNeutral}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                            To="#334668" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                            To="#24344D" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                            To="#B91C1C" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                            To="#991B1B" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24344D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowNavButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E11D48"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3394A3B8" CornerRadius="3" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" 
                              Focusable="False" 
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" 
                                    Background="#101726" 
                                    BorderBrush="{StaticResource BorderDark}" 
                                    BorderThickness="1" 
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow" 
                                          Grid.Column="1" 
                                          Fill="{DynamicResource AccentColor}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#162032"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" 
                                  IsHitTestVisible="False" 
                                  Content="{TemplateBinding SelectionBoxItem}" 
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                  Margin="10,0,28,0" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Left"/>
                <Popup x:Name="Popup" 
                       Placement="Bottom" 
                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                       AllowsTransparency="True" 
                       Focusable="False" 
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown" 
                          SnapsToDevicePixels="True" 
                          MinWidth="{TemplateBinding ActualWidth}" 
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" 
                                Background="#101726" 
                                BorderBrush="{StaticResource BorderDark}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Margin="0,2,0,0">
                            <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#101726"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24344D"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#101726"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderDark}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabContent" 
                                              ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#24344D"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C273C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1124344D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgCanvas}">

        <!-- CORREÇÃO 1: As definições de Linha têm de estar no topo do Grid ANTES de qualquer controlo -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- OVERLAY RENOMEAR ITEM DA PROGRAMAÇÃO -->
        <Grid x:Name="OverlayRename" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100" Grid.RowSpan="2">
            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Renomear Item da Programação" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtRenameItem" Style="{DynamicResource DarkTextBox}" Margin="0,0,0,15" KeyDown="TxtRenameItem_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnCancelRename_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0"/>
                        <Button Content="Guardar" Click="BtnSaveRename_Click" Style="{DynamicResource GoldButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="#060A12" Padding="14,6,8,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Button x:Name="BtnModeLive" Content="LIVE" Click="BtnModeLive_Click" Style="{DynamicResource NavyButton}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Transmitir (F5)"/>
                    <Button x:Name="BtnModeLogo" Content="LOGO" Click="BtnModeLogo_Click" Style="{DynamicResource NavyButton}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Clique com o Botão Direito para definir a imagem/vídeo (F6)!">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Definir ficheiro de Logo..." Click="MenuSetLogo_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnModeClear" Content="CLEAR" Click="BtnModeClear_Click" Style="{DynamicResource NavyButton}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Limpar Ecrã (Esc)"/>
                    <Button Click="BtnOpenAlerts_Click" Style="{DynamicResource NavyButton}" Margin="0,0,6,0" Padding="12,6" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Informações e Alertas">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE783;" FontSize="15" VerticalAlignment="Center"/>
                    </Button>
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <MenuItem Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ButtonNeutral}" Padding="12,6" FontWeight="Medium" ToolTip="Ferramentas do Sistema">
                            <MenuItem.Header>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="15" VerticalAlignment="Center"/>
                            </MenuItem.Header>
                            <MenuItem Header="Personalizar Layout (Lego)" Click="BtnOpenLayoutConfig_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Definições de Projeção" Click="BtnOpenSettings_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Importar EasyWorship" Click="BtnImportEasyWorship_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Importar Bíblia (SQLite)" Click="BtnImportBible_Click" Background="#162032" Foreground="White">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Click="BtnMinimize_Click" Style="{DynamicResource WindowNavButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE921;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnMaximize_Click" Style="{DynamicResource WindowNavButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE922;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CORPO PRINCIPAL -->
        <Grid x:Name="MainColumnsGrid" Grid.Row="1" Margin="14,12,14,14" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. PAINEL: EM DIRETO -->
            <Border x:Name="PanelLive" Grid.Column="0" Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border Width="320" Height="180" Background="Black" CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                        <Grid>
                            <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" IsMuted="True" MediaEnded="PreviewVideo_MediaEnded"/>
                            <Image x:Name="PreviewBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Viewbox Margin="14" Stretch="Uniform">
                                <TextBlock x:Name="TxtPreview" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.95"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>
                            <!-- Badge EM DIRETO -->
                            <Border x:Name="BadgeLiveBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC060A12" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="4" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="BadgeLiveDot" Width="7" Height="7" Fill="#EF4444" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="BadgeLiveText" Text="EM DIRETO" Foreground="#EF4444" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>
            </Border>

            <!-- 2. PAINEL: PROGRAMAÇÃO -->
            <Border x:Name="PanelSchedule" Grid.Column="0" Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" Foreground="{DynamicResource AccentColor}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Programação" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="BtnLoadPlaylist_Click" Style="{DynamicResource NavyButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="Abrir Culto">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8E5;" FontSize="12"/>
                            </Button>
                            <Button Click="BtnSavePlaylist_Click" Style="{DynamicResource NavyButton}" Padding="6,2" Margin="0,0,8,0" ToolTip="Gravar Culto">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE792;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <!-- ESTADO VAZIO (EMPTY STATE) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=LstSchedule}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE81C;" FontSize="28" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Arraste itens para iniciar o culto" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,6,0,0" Opacity="0.7"/>
                        </StackPanel>

                        <!-- LISTA DE PROGRAMAÇÃO COM DUPLO-CLIQUE -->
                        <ListBox x:Name="LstSchedule" 
                                 MouseDoubleClick="LstSchedule_MouseDoubleClick" 
                                 ItemContainerStyle="{DynamicResource AnimatedCardItemStyle}" 
                                 SelectionChanged="LstSchedule_SelectionChanged" 
                                 KeyDown="LstSchedule_KeyDown" 
                                 AllowDrop="True" 
                                 Drop="LstSchedule_Drop" 
                                 DragOver="LstSchedule_DragOver" 
                                 PreviewMouseLeftButtonDown="LstSchedule_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LstSchedule_PreviewMouseMove" 
                                 PreviewMouseLeftButtonUp="LstSchedule_PreviewMouseLeftButtonUp"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,4,4">

                                        <!-- BORDA COM A COR DO TEMA (Substituído o Verde pelo AccentColor) -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Renomear Item..." Click="MenuRenameScheduleItem_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" Foreground="White"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Remover da Lista" Click="BtnScheduleRemove_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" Foreground="#EF4444"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="Shadow" Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.2"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ItemTypeIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <!-- TEXTO COM A COR DO TEMA (Substituído o Verde pelo AccentColor) -->
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius" To="8" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 3. PAINEL: SLIDES ATIVOS (MANTIDO) -->
            <Border x:Name="PanelSlides" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel>
                    <TextBlock x:Name="TxtSelectedSongTitle" DockPanel.Dock="Top" Text="Nenhum item selecionado" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,10" TextTrimming="CharacterEllipsis"/>
                    <ListBox x:Name="LstSlides" ItemContainerStyle="{DynamicResource AnimatedCardItemStyle}" SelectionChanged="LstSlides_SelectionChanged" BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,3,6,6" Background="{DynamicResource CardBg}">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="Shadow" Color="Black" BlurRadius="10" ShadowDepth="4" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 4. PAINEL: RECURSOS -->
            <Border x:Name="PanelResources" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                <TabControl>
                    <!-- Aba Músicas -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D6;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Músicas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,8,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchSong" Grid.Column="0" Style="{DynamicResource SearchTextBox}" TextChanged="TxtSearchSong_TextChanged"/>
                                <Button Grid.Column="1" Click="BtnEditSong_Click" Style="{DynamicResource NavyButton}" Padding="8,4" Margin="6,0,0,0" ToolTip="Editar Música Selecionada">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="BtnNewSong_Click" Style="{DynamicResource GoldButton}" Padding="8,4" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nova" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListBox x:Name="LstSongs" DisplayMemberPath="Title" SelectionChanged="LstSongs_SelectionChanged" PreviewMouseMove="LstSongs_PreviewMouseMove" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </TabItem>

                    <!-- Aba Bíblia -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE82D;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Bíblia" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Ex: jo 3:16, sl 23 ou palavra" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchBible" Grid.Column="0" Style="{DynamicResource SearchTextBox}" Margin="0,0,4,0" KeyDown="TxtSearchBible_KeyDown"/>
                                <ComboBox x:Name="CmbBibleVersion" Grid.Column="1" SelectionChanged="CmbBibleVersion_SelectionChanged"/>
                            </Grid>
                            <ListBox x:Name="LstBibleResults" DisplayMemberPath="Reference" SelectionMode="Extended" 
                                     SelectionChanged="LstBibleResults_SelectionChanged" 
                                     PreviewMouseLeftButtonDown="LstBibleResults_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="LstBibleResults_PreviewMouseMove" 
                                     PreviewMouseLeftButtonUp="LstBibleResults_PreviewMouseLeftButtonUp"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </TabItem>

                    <!-- Aba Fundos -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE91B;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Fundos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,8,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnImportBackground_Click" Style="{DynamicResource GoldButton}" Margin="0,0,6,0" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Importar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="BtnClearBackground_Click" Style="{DynamicResource NavyButton}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE894;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Limpar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RbFilterAll" Content="Todos" IsChecked="True" Checked="BgFilter_Changed" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbFilterVideos" Content="Vídeos" Checked="BgFilter_Changed" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbFilterImages" Content="Fotos" Checked="BgFilter_Changed" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <ListBox x:Name="LstBackgrounds" ItemContainerStyle="{DynamicResource AnimatedCardItemStyle}" SelectionChanged="LstBackgrounds_SelectionChanged" AllowDrop="True" Drop="LstBackgrounds_Drop" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Width="105" Height="75" Margin="4,4,8,8" ClipToBounds="True" MouseEnter="BackgroundItem_MouseEnter" MouseLeave="BackgroundItem_MouseLeave">
                                            <Grid>
                                                <Image Source="{Binding OptimizedThumbnail, IsAsync=True}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,2" CornerRadius="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#CC1E3A8A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Background" Value="#CC991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="White" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="📷 FOTO"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                        <Setter Property="Text" Value="🎬 VÍDEO"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#DD060A12" VerticalAlignment="Bottom" Padding="4,3">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding Name}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 5. PAINEL: GRUPO DE LOUVOR (MANTIDO) -->
            <Border x:Name="PanelWorshipTeam" Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE1D6;" Foreground="{DynamicResource AccentColor}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Equipa" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbPresetMembers" Height="30" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Click="BtnAddTeamMember_Click" Style="{DynamicResource GoldButton}" Padding="10,4" Margin="6,0,0,0" ToolTip="Adicionar Membro">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="LstActiveTeam" ItemContainerStyle="{DynamicResource AnimatedCardItemStyle}" BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,3,4,4">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="Shadow" Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                                    </Border.Effect>
                                    <DockPanel LastChildFill="True">
                                        <Button Click="BtnEditTeamMember_Click" DockPanel.Dock="Right" Focusable="False" Background="Transparent" Foreground="{DynamicResource AccentColor}" BorderThickness="0" FontSize="13" Width="26" Height="26" Cursor="Hand" ToolTip="Editar" Margin="4,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;"/>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>