<Window x:Class="WorshipProjectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IEBCR II Setúbal - Sistema de Projeção Multimédia" 
        Height="780" Width="1280" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource MainWindowStyle}"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainColumnsGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.4"
                                     DecelerationRatio="0.8"/>
                    <DoubleAnimation Storyboard.TargetName="MainColumnsGrid"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.5"
                                     DecelerationRatio="0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="MainWindowStyle" TargetType="Window">
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="BgCanvas" Color="#070A10" po:Freeze="True"/>
        <SolidColorBrush x:Key="PanelBg" Color="#111827" po:Freeze="True"/>
        <SolidColorBrush x:Key="CardBg" Color="#1A2234" po:Freeze="True"/>
        <SolidColorBrush x:Key="CardHoverBg" Color="#222D42" po:Freeze="True"/>
        <SolidColorBrush x:Key="BorderDark" Color="#26334D" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" po:Freeze="True"/>
        <SolidColorBrush x:Key="ButtonNeutral" Color="#1E293B" po:Freeze="True"/>
        <SolidColorBrush x:Key="ButtonNeutralHover" Color="#334155" po:Freeze="True"/>

        <!-- ================= BOTÕES ================= -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="#070A10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonNeutral}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonNeutralHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FECACA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource NavyButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26334D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= EXPANDER DE PASTAS ================= -->
        <Style x:Key="FolderExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel>
                                <!-- Cabeçalho da Pasta -->
                                <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0" Padding="12,10">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Arrow" Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE76C;" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Content>
                                        <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton.Content>
                                </ToggleButton>
                                <!-- Conteúdo (Lista de Músicas da Pasta) -->
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= OUTROS COMPONENTES ================= -->
        <Style x:Key="PillRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="#1A2234"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#243049"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#070A10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowNavButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ThumbTemplate" TargetType="Thumb">
            <Border x:Name="Th" Background="#475569" CornerRadius="3"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Th" Property="Background" Value="#64748B"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="Th" Property="Background" Value="#94A3B8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="1,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource ThumbTemplate}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsMainMenu" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#111827" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="8,0,18,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Bd" Background="{StaticResource ButtonNeutral}" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="#111827" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="260">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonNeutralHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#090D16"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B4D71"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Background" Value="#05080F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Dark Template -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" Background="#090D16" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow" Grid.Column="1" Fill="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#141C2B"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="#111827" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                            <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#243049"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderDark}"/>
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Grid>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabContent" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A2234"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A2234"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1,4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#1A2234"/>
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#26334D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- OVERLAY MODAL: RENOMEAR ITEM DA PROGRAMAÇÃO -->
        <Grid x:Name="OverlayRename" Background="#B205080E" Visibility="Collapsed" Panel.ZIndex="100" Grid.RowSpan="2">
            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Foreground="{DynamicResource AccentColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Renomear Item da Programação" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="TxtRenameItem" Style="{StaticResource SearchTextBox}" Margin="0,0,0,18" KeyDown="TxtRenameItem_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnCancelRename_Click" Style="{StaticResource NavyButton}" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Content="Guardar Alteração" Click="BtnSaveRename_Click" Style="{StaticResource GoldButton}" Height="32" Padding="14,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- CABEÇALHO SUPERIOR (BARRA DE ESTÚDIO)                     -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#05080E" Padding="14,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BORDER ÚNICO QUE ENGLOBARÁ TODOS OS BOTÕES DE CONTROLO E ÍCONES -->
                    <Border Background="#0D131F" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="3" Height="38" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 1. Botões de Estado do Projetor -->
                            <Button x:Name="BtnModeLive" Content="● LIVE" Click="BtnModeLive_Click" Style="{DynamicResource NavyButton}" Margin="0,0,3,0" Height="30" Padding="14,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Transmitir para o Projetor (F5)"/>
                            <Button x:Name="BtnModeLogo" Content="LOGO" Click="BtnModeLogo_Click" Style="{DynamicResource NavyButton}" Margin="0,0,3,0" Height="30" Padding="14,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Ativar Logo (F6) | Botão Direito para escolher ficheiro">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Definir ficheiro de Logo..." Click="MenuSetLogo_Click">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B9;" Foreground="{DynamicResource AccentColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="BtnModeClear" Content="CLEAR" Click="BtnModeClear_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0" Height="30" Padding="14,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Limpar Texto do Ecrã (Esc)"/>

                            <!-- Uma linha divisória suave para separar as ações de projetor dos menus de app -->
                            <Rectangle Width="1" Fill="{DynamicResource BorderDark}" Margin="0,4,8,4"/>

                            <!-- 2. Botões de Ícones (Alertas e Menu de Settings) -->
                            <Button Click="BtnOpenAlerts_Click" Style="{DynamicResource IconButton}" Width="30" Height="30" Margin="0,0,3,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Informações, Alertas e Cronómetro">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE783;" FontSize="14" Foreground="{DynamicResource AccentColor}"/>
                            </Button>

                            <Menu Height="30" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                                <!-- Coloquei o Menu a emular o estilo NavyButton para ficar consistente -->
                                <MenuItem Width="30" Height="30" Padding="0" Margin="0" VerticalAlignment="Center" ToolTip="Configurações e Importação">
                                    <MenuItem.Header>
                                        <Border Background="{StaticResource ButtonNeutral}" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Width="30" Height="30" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="14" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </MenuItem.Header>

                                    <MenuItem Header="Personalizar Layout (Lego)" Click="BtnOpenLayoutConfig_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C3;" Foreground="{DynamicResource AccentColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Definições de Projeção" Click="BtnOpenSettings_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Foreground="{DynamicResource AccentColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Border Height="1" Background="#26334D" Margin="6,4"/>
                                    <MenuItem Header="Importar EasyWorship (Songs.db)" Click="BtnImportEasyWorship_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Foreground="{DynamicResource TextMuted}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Importar Bíblia (SQLite)" Click="BtnImportBible_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Foreground="{DynamicResource TextMuted}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CENTRO: Relógio Digital Estilo Régie -->
                <Border Grid.Column="1" Background="#0D131F" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" Padding="14,5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE121;" FontSize="13" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTopClock" Text="00:00:00" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnMinimize_Click" Style="{DynamicResource WindowNavButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE921;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnMaximize_Click" Style="{DynamicResource WindowNavButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE922;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fechar Aplicação">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CORPO PRINCIPAL (GRELHA DE PAINÉIS) -->
        <Grid x:Name="MainColumnsGrid" Grid.Row="1" Margin="8,6,8,8" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" MinWidth="250"/>
                <ColumnDefinition Width="1.5*" MinWidth="240"/>
                <ColumnDefinition Width="1.4*" MinWidth="240"/>
                <ColumnDefinition Width="1.0*" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- 1. PAINEL: MONITOR DE SAÍDA (EM DIRETO)                   -->
            <!-- ========================================================= -->
            <Border x:Name="PanelLive" Grid.Column="0" Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="16:9 HD" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" Foreground="{DynamicResource AccentColor}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MONITOR DE SAÍDA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Border Width="320" Height="180" Background="#030508" CornerRadius="8" BorderBrush="#334155" BorderThickness="1.5">
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,317,177" RadiusX="6.5" RadiusY="6.5"/>
                                </Grid.Clip>

                                <!-- O MediaElement foi removido! Fica apenas a Imagem que vai receber a miniatura -->
                                <Image x:Name="PreviewBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Viewbox Margin="16" Stretch="Uniform">
                                    <TextBlock x:Name="TxtPreview" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.95"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Viewbox>
                                <Border x:Name="BadgeLiveBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#D9060A12" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="BadgeLiveDot" Width="7" Height="7" Fill="#EF4444" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="BadgeLiveText" Text="EM DIRETO" Foreground="#EF4444" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. PAINEL: PROGRAMAÇÃO DO CULTO (COM PASTAS)              -->
            <!-- ========================================================= -->
            <Border x:Name="PanelSchedule" Grid.Column="0" Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" Foreground="{DynamicResource AccentColor}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PROGRAMAÇÃO" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- BOTÃO ADICIONAR PASTA -->
                                <Button Click="BtnAddFolder_Click" Style="{StaticResource IconButton}" Margin="0,0,8,0" ToolTip="Adicionar Nova Pasta">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13" Foreground="{DynamicResource AccentColor}"/>
                                </Button>
                                <Button Click="BtnLoadPlaylist_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" ToolTip="Abrir Culto (.json)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" FontSize="12"/>
                                </Button>
                                <Button Click="BtnSavePlaylist_Click" Style="{StaticResource IconButton}" ToolTip="Gravar Culto (.json)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Background="#0B0F19" Margin="2" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=LstSchedule}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#141C2B" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="20" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                </Border>
                                <TextBlock Text="Programação Vazia" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="Crie pastas e adicione músicas." Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.75"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="LstSchedule" 
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 MouseDoubleClick="LstSchedule_MouseDoubleClick" 
                                 ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" 
                                 SelectionChanged="LstSchedule_SelectionChanged" 
                                 KeyDown="LstSchedule_KeyDown" 
                                 AllowDrop="True" 
                                 Drop="LstSchedule_Drop" 
                                 DragOver="LstSchedule_DragOver" 
                                 PreviewMouseLeftButtonDown="LstSchedule_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LstSchedule_PreviewMouseMove" 
                                 PreviewMouseLeftButtonUp="LstSchedule_PreviewMouseLeftButtonUp"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- LAYOUT 1: ITEM NORMAL -->
                                        <Border x:Name="ItemBorder" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,2,4,4">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Renomear Item..." Click="MenuRenameScheduleItem_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Foreground="White"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Remover da Lista" Click="BtnScheduleRemove_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Foreground="#EF4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#111827" BorderBrush="#26334D" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemTypeIcon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TitleTxt" Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Ellipse x:Name="ActiveDot" Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="8,0,2,0" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <!-- LAYOUT 2: PASTA (EXPANDER) -->
                                        <Border x:Name="FolderBorder" Visibility="Collapsed" Background="#141C2B" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Margin="0,4,4,8">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Renomear Pasta..." Click="MenuRenameScheduleItem_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Foreground="White"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Remover Pasta" Click="BtnScheduleRemove_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Foreground="#EF4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Expander Style="{StaticResource FolderExpanderStyle}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Lado Esquerdo: Ícone, Título e Contador -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="15" Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                            <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="10,0,0,0">
                                                                <!-- Contador de Itens dentro da Pasta -->
                                                                <TextBlock Text="{Binding SubItems.Count}" FontSize="10" Foreground="{DynamicResource TextMuted}" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Lado Direito: Botões (Ficam ocultos se a pasta estiver fechada) -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <Button Click="BtnMoveSubItemUp_Click" Style="{StaticResource NavyButton}" Width="26" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Mover selecionado para Cima">
                                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="10"/>
                                                            </Button>
                                                            <Button Click="BtnMoveSubItemDown_Click" Style="{StaticResource NavyButton}" Width="26" Height="24" Padding="0" ToolTip="Mover selecionado para Baixo">
                                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander.Header>

                                                <!-- CONTEÚDO DA PASTA -->
                                                <Border Background="#090D16" CornerRadius="0,0,8,8" Padding="6,8,6,2">

                                                    <ListBox ItemsSource="{Binding SubItems}" 
                                                    ItemContainerStyle="{StaticResource AnimatedCardItemStyle}"
                                                    SelectionChanged="InnerList_SelectionChanged" 
                                                    PreviewMouseLeftButtonDown="LstSchedule_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="LstSchedule_PreviewMouseMove"
                                                    AllowDrop="True"
                                                    Drop="InnerList_Drop"
                                                    DragOver="LstSchedule_DragOver"
                                                    MinHeight="40"
                                                    BorderThickness="0" Background="Transparent" 
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="SubItemBorder" Background="{DynamicResource CardBg}" BorderBrush="#26334D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">

                                                                    <!-- NOVO MENU DE CONTEXTO EXCLUSIVO DOS SUBITENS -->
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Renomear Item..." Click="MenuRenameScheduleItem_Click">
                                                                                <MenuItem.Icon>
                                                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Foreground="White"/>
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="Remover da Pasta" Click="MenuRemoveAnyItem_Click">
                                                                                <MenuItem.Icon>
                                                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Foreground="#EF4444"/>
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <!-- (Mantém o resto igual a partir daqui...) -->
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="#111827" BorderBrush="#26334D" BorderThickness="1" Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding ItemTypeIcon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock x:Name="SubTitleTxt" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <Ellipse x:Name="SubActiveDot" Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="6,0,2,0" Visibility="Collapsed"/>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                                                        <Setter TargetName="SubItemBorder" Property="Background" Value="#222D42"/>
                                                                        <Setter TargetName="SubItemBorder" Property="BorderBrush" Value="#3B4D71"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                                                        <Setter TargetName="SubItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                                        <Setter TargetName="SubItemBorder" Property="Background" Value="#1C283D"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter TargetName="SubItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                                        <Setter TargetName="SubItemBorder" Property="Background" Value="#1C283D"/>
                                                                        <Setter TargetName="SubTitleTxt" Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                                        <Setter TargetName="SubActiveDot" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Expander>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="FolderBorder" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#222D42"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B4D71"/>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#475D85"/>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#202B42"/>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#202B42"/>
                                            <Setter TargetName="TitleTxt" Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- 3. PAINEL: SLIDES ATIVOS                                  -->
            <!-- ========================================================= -->
            <Border x:Name="PanelSlides" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ITEM EM PREPARAÇÃO / PROJEÇÃO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtSelectedSongTitle" Text="Nenhum item selecionado" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Click="BtnPrevSlide_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" ToolTip="Slide Anterior (Seta Cima)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="11"/>
                                </Button>
                                <Button Click="BtnNextSlide_Click" Style="{StaticResource IconButton}" ToolTip="Próximo Slide (Seta Baixo / Espaço)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LstSlides" 
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" 
                             SelectionChanged="LstSlides_SelectionChanged" 
                             BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,3,6,6" Background="{DynamicResource CardBg}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                            <Border DockPanel.Dock="Left" Background="#111827" BorderBrush="#26334D" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" FontSize="11"/>
                                            </Border>
                                            <Border DockPanel.Dock="Right" Background="#CC1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                    Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="🖼️ FUNDO" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="21"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#222D42"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B4D71"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                        <Setter TargetName="CardBorder" Property="Background" Value="#202B42"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- 4. PAINEL: BIBLIOTECA DE RECURSOS                         -->
            <!-- ========================================================= -->
            <Border x:Name="PanelResources" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
                <TabControl>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Músicas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,12,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Nova coluna para o filtro -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtSearchSong" Grid.Column="0" Style="{StaticResource SearchTextBox}" TextChanged="TxtSearchSong_TextChanged" ToolTip="Pesquisar música..." Margin="0,0,6,0"/>

                                <!-- NOVO COMBOBOX DE MODO (Título vs Letra) -->
                                <ComboBox x:Name="CmbSearchSongMode" Grid.Column="1" Width="110" SelectionChanged="SongSearchMode_Changed" Margin="0,0,6,0" ToolTip="Modo de Pesquisa">
                                    <ComboBoxItem Content="Por Título" IsSelected="True"/>
                                    <ComboBoxItem Content="Por Letra"/>
                                </ComboBox>

                                <Button Grid.Column="2" Click="BtnNewSong_Click" Style="{StaticResource GoldButton}" Height="34" Padding="12,0" ToolTip="Criar Nova Música">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock Text="Nova" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListBox x:Name="LstSongs" 
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.CacheLength="1,1"
                                     VirtualizingPanel.CacheLengthUnit="Page"
                                     ItemContainerStyle="{StaticResource ModernListItemStyle}" 
                                     SelectionChanged="LstSongs_SelectionChanged" 
                                     PreviewMouseMove="LstSongs_PreviewMouseMove" 
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <!-- MENU DE CONTEXTO (RIGHT-CLICK) -->
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Editar Música..." Click="MenuEditSong_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Foreground="White"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Apagar Música" Click="MenuDeleteSong_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Foreground="#EF4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" Foreground="{DynamicResource AccentColor}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0.85"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Artist}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE82D;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Bíblia" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,12,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Para o Modo -->
                                    <ColumnDefinition Width="96"/>
                                    <!-- Para a Versão -->
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtSearchBible" Grid.Column="0" Style="{StaticResource SearchTextBox}" Margin="0,0,6,0" KeyDown="TxtSearchBible_KeyDown"/>

                                <!-- NOVO COMBOBOX DE MODO (Livro vs Palavras) -->
                                <ComboBox x:Name="CmbSearchBibleMode" Grid.Column="1" Width="115" Margin="0,0,6,0" ToolTip="Modo de Pesquisa">
                                    <ComboBoxItem Content="Por Livro/Ref." IsSelected="True"/>
                                    <ComboBoxItem Content="Por Palavras"/>
                                </ComboBox>

                                <ComboBox x:Name="CmbBibleVersion" Grid.Column="2" SelectionChanged="CmbBibleVersion_SelectionChanged"/>
                            </Grid>
                            
                            <ListBox x:Name="LstBibleResults" 
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.CacheLength="1,1"
                                     VirtualizingPanel.CacheLengthUnit="Page"
                                     ItemContainerStyle="{StaticResource ModernListItemStyle}" 
                                     SelectionMode="Extended" 
                                     SelectionChanged="LstBibleResults_SelectionChanged" 
                                     PreviewMouseLeftButtonDown="LstBibleResults_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="LstBibleResults_PreviewMouseMove" 
                                     PreviewMouseLeftButtonUp="LstBibleResults_PreviewMouseLeftButtonUp"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Reference}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" FontSize="12"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Opacity="0.9"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE91B;" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Fundos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="0,12,0,0">
                            <!-- BARRA SUPERIOR: IMPORTAR E LIMPAR -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnImportBackground_Click" Style="{StaticResource GoldButton}" Margin="0,0,6,0" Height="34" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Importar Multimédia" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="BtnClearBackground_Click" Style="{StaticResource NavyButton}" Height="34" Padding="12,0" ToolTip="Remover fundo ativo">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE894;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Limpar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- NOVA BARRA DE PESQUISA (TEXTO + MODO) -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchBackground" Grid.Column="0" Style="{StaticResource SearchTextBox}" TextChanged="TxtSearchBackground_TextChanged" ToolTip="Pesquisar fundo por nome..." Margin="0,0,6,0"/>

                                <ComboBox x:Name="CmbSearchBgMode" Grid.Column="1" Width="120" SelectionChanged="BgFilter_Changed">
                                    <ComboBoxItem Content="Nome exato" IsSelected="True"/>
                                    <ComboBoxItem Content="Nome contém"/>
                                </ComboBox>
                            </Grid>

                            <!-- OS FILTROS ORIGINAIS DE VÍDEO/FOTO (MANTÉM AS BOLINHAS PARA ISTO) -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RbFilterAll" Content="Todos" Style="{StaticResource PillRadioButton}" IsChecked="True" Checked="BgFilter_Changed"/>
                                <RadioButton x:Name="RbFilterVideos" Content="🎬 Vídeos" Style="{StaticResource PillRadioButton}" Checked="BgFilter_Changed"/>
                                <RadioButton x:Name="RbFilterImages" Content="📷 Fotos" Style="{StaticResource PillRadioButton}" Checked="BgFilter_Changed"/>
                            </StackPanel>

                            <ListBox x:Name="LstBackgrounds" ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" SelectionChanged="LstBackgrounds_SelectionChanged" AllowDrop="True" Drop="LstBackgrounds_Drop" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="BgCard" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="8" Width="112" Height="80" Margin="3,3,6,6" MouseEnter="BackgroundItem_MouseEnter" MouseLeave="BackgroundItem_MouseLeave">
                                            <Grid>
                                                <Grid.Clip>
                                                    <RectangleGeometry Rect="0,0,109,77" RadiusX="6.5" RadiusY="6.5"/>
                                                </Grid.Clip>
                                                <Image Source="{Binding OptimizedThumbnail, IsAsync=True}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="6,3" CornerRadius="0,0,0,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#CC1E3A8A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Background" Value="#CC991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="White" FontSize="8" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="📷 FOTO"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                        <Setter Property="Text" Value="🎬 VÍDEO"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#E6060A12" VerticalAlignment="Bottom" Padding="6,4">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding Name}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                                <Setter TargetName="BgCard" Property="BorderBrush" Value="#3B4D71"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                                <Setter TargetName="BgCard" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ========================================================= -->
            <!-- 5. PAINEL: EQUIPA DE LOUVOR (MICROFONES & RETORNO)        -->
            <!-- ========================================================= -->
            <Border x:Name="PanelWorshipTeam" Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="MIC / IEM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE1D6;" Foreground="{DynamicResource AccentColor}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="EQUIPA DE LOUVOR" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbPresetMembers" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Click="BtnAddTeamMember_Click" Style="{StaticResource GoldButton}" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="Adicionar Membro à Escala">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="LstActiveTeam" ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,2,4,4">
                                    <DockPanel LastChildFill="True">
                                        <Button Click="BtnEditTeamMember_Click" DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Editar Canais / Remover">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" FontSize="12"/>
                                        </Button>

                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,2,0">
                                            <Border Background="#1E3A8A" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" ToolTip="Canal do Microfone">
                                                <TextBlock Text="{Binding Microphone}" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip="Canal de Retorno (In-Ear)">
                                                <TextBlock Text="{Binding InEarReturn}" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#222D42"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B4D71"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>