<Window x:Class="WorshipProjectionApp.ProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorshipProjectionApp"
        Title="IEBCR II Setúbal - Saída de Projeção"
        Background="Black"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid Background="Black" ClipToBounds="True">
        <!-- Camada 1: Vídeo de Fundo -->
        <MediaElement x:Name="MediaBgVideo"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="UniformToFill"
                      IsMuted="True"
                      RenderOptions.BitmapScalingMode="LowQuality"
                      MediaEnded="MediaBgVideo_MediaEnded"
                      Opacity="0"/>

        <!-- Camada 2: Imagem Estática de Fundo -->
        <Image x:Name="MediaBgImage"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0"/>

        <!-- Camada 3: Filtro Escuro Suave para Contraste -->
        <Rectangle x:Name="OverlayDimmer" Fill="#000000" Opacity="0.15"/>

        <!-- Camada 4: Área das Letras e Versículos (tamanho fixo; só reduz se o texto não couber) -->
        <Grid x:Name="TextLayer" Opacity="1">
            <Viewbox x:Name="ViewboxContent" Stretch="Uniform" StretchDirection="DownOnly" Margin="70">
                <Border x:Name="TextHost" Visibility="Collapsed">
                    <local:OutlinedTextBlock x:Name="TxtProjection"
                                             Foreground="White"
                                             FontFamily="Segoe UI"
                                             FontWeight="Bold"
                                             FontSize="84"
                                             TextAlignment="Center"
                                             LineHeight="100"
                                             Stroke="Black"
                                             StrokeThickness="0"
                                             MaxWidth="1700">
                        <local:OutlinedTextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Direction="315" Opacity="0.95" RenderingBias="Quality"/>
                        </local:OutlinedTextBlock.Effect>
                    </local:OutlinedTextBlock>
                </Border>
            </Viewbox>

            <!-- Referência bíblica pequena no fundo do ecrã -->
            <TextBlock x:Name="TxtReference"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,40"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="36"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="1600">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.95" RenderingBias="Quality"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- Camada 5: Alertas e Cronómetros (Ecrã Inteiro) -->
        <Grid x:Name="FullScreenAlertOverlay" Background="#F5060A12" Opacity="0" Visibility="Collapsed">
            <Viewbox Stretch="Uniform" Margin="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Relógio / Temporizador Gigante -->
                    <TextBlock x:Name="TxtProjectionClock" 
                               Foreground="#D4AF37" 
                               FontWeight="Bold" 
                               FontSize="200" 
                               TextAlignment="Center"
                               Margin="0,0,0,20">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.95" RenderingBias="Quality"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Mensagem de Informação -->
                    <TextBlock x:Name="TxtProjectionAlert" 
                               Foreground="#F8FAFC" 
                               FontWeight="SemiBold" 
                               FontSize="80" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               MaxWidth="1600">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="6" Opacity="0.95" RenderingBias="Quality"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>