<Window x:Class="WorshipProjectionApp.EditTeamMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Membro do Louvor" 
        Height="360" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#060A12" Padding="14,6,6,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <TextBlock Text="✏️ Editar / Ajustar Membro" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Nome da Pessoa:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtName" Style="{DynamicResource DarkTextBox}" Margin="0,0,0,10"/>

                    <TextBlock Text="Função / Instrumento:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRole" Style="{DynamicResource DarkTextBox}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Microfone / Canal:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtMic" Style="{DynamicResource DarkTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Retorno In-Ear / Aux:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtReturn" Style="{DynamicResource DarkTextBox}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <Button Content="🗑️ Remover" Click="BtnDelete_Click" Style="{DynamicResource DangerButton}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Cancelar" Click="BtnCancel_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0"/>
                    <Button Content="Guardar" Click="BtnSave_Click" Style="{DynamicResource GoldButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>