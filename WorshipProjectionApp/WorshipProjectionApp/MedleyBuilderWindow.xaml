<Window x:Class="WorshipProjectionApp.MedleyBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Construtor de Medley" Height="700" Width="1150" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvas}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="#060A12" Padding="14,6,6,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <TextBlock Text="🔗 Construtor de Medley (Transição de Músicas)" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- CORPO DAS 3 COLUNAS -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUNA ESQUERDA: MÚSICA 1 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="1ª Música" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextMuted}"/>
                    <ComboBox x:Name="CmbSongLeft" DockPanel.Dock="Top" SelectionChanged="CmbSongLeft_SelectionChanged" DisplayMemberPath="Title" Height="34" Margin="0,0,0,10"/>

                    <ListBox x:Name="LstLeftSlides" ItemsSource="{Binding LeftSlides}" 
                             MouseDoubleClick="LstLeftSlides_MouseDoubleClick" 
                             PreviewMouseLeftButtonDown="SlideList_PreviewMouseLeftButtonDown"
                             MouseMove="SlideList_MouseMove"
                             ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A2234" BorderBrush="#26334D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </DockPanel>
            </Border>

            <!-- COLUNA CENTRAL: O MEDLEY -->
            <Border Grid.Column="1" Background="#0D131F" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Estrutura do Medley (Duplo clique nas laterais para adicionar)" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center"/>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Título do Medley:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox x:Name="TxtMedleyTitle" Style="{StaticResource SearchTextBox}"/>
                    </DockPanel>

                    <!-- COLUNA CENTRAL: O MEDLEY -->
                    <ListBox x:Name="LstMedleySlides" ItemsSource="{Binding MedleySlides}" 
                                MouseDoubleClick="LstMedleySlides_MouseDoubleClick" 
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="SlideList_PreviewMouseLeftButtonDown"
                                MouseMove="SlideList_MouseMove"
                                DragOver="MedleyList_DragOver"
                                Drop="MedleyList_Drop"
                                ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold"/>
                                        <!-- CORRIGIDO: Transformado num Botão interativo para remover ao clicar -->
                                        <Button Content="❌ Remover" Click="BtnRemoveMedleyItem_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="9" Foreground="#EF4444"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </DockPanel>
            </Border>

            <!-- COLUNA DIREITA: MÚSICA 2 -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="2ª Música" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextMuted}"/>
                    <ComboBox x:Name="CmbSongRight" DockPanel.Dock="Top" SelectionChanged="CmbSongRight_SelectionChanged" DisplayMemberPath="Title" Height="34" Margin="0,0,0,10"/>

                    <!-- COLUNA DIREITA: MÚSICA 2 -->
                    <ListBox x:Name="LstRightSlides" ItemsSource="{Binding RightSlides}" 
         MouseDoubleClick="LstRightSlides_MouseDoubleClick" 
         PreviewMouseLeftButtonDown="SlideList_PreviewMouseLeftButtonDown"
         MouseMove="SlideList_MouseMove"
         ItemContainerStyle="{StaticResource AnimatedCardItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A2234" BorderBrush="#26334D" BorderThickness="1" CornerRadius="0" Padding="10" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- BARRA DE ACÕES INFERIOR -->
        <Border Grid.Row="2" Background="#060A12" Padding="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="Cancelar" Click="BtnClose_Click" Style="{DynamicResource NavyButton}" DockPanel.Dock="Left" Width="100"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Apenas Adicionar ao Culto" Click="BtnAddToSchedule_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0" ToolTip="Insere temporariamente na programação"/>
                    <Button Content="Gravar como Nova Música" Click="BtnSaveAsNewSong_Click" Style="{DynamicResource GoldButton}" ToolTip="Grava definitivamente na base de dados"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>