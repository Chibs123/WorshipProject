<Window x:Class="WorshipProjectionApp.LayoutConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Layout Lego (Grelha 4x4)" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#060A12" Padding="14,6,6,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <TextBlock Text="🧩 Construtor Lego: Matriz 4x4" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Click="BtnClose_Click" Style="{DynamicResource WindowCloseButton}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Personaliza a posição e a dimensão de cada bloco no ecrã." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,14"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="1. Seleciona a Peça:" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ListBox x:Name="LstPieces" Height="110" Background="#0B0F19" BorderBrush="{DynamicResource BorderDark}" SelectionChanged="LstPieces_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Foreground="White" Padding="4,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="2. Posição Inicial:" FontWeight="Bold" Margin="0,14,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Linha Inicial:" VerticalAlignment="Center" Width="95"/>
                                <ComboBox x:Name="CmbRow" SelectionChanged="ParamChanged">
                                    <ComboBoxItem Content="Linha 1 (Topo)"/>
                                    <ComboBoxItem Content="Linha 2"/>
                                    <ComboBoxItem Content="Linha 3"/>
                                    <ComboBoxItem Content="Linha 4 (Fundo)"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Coluna Inicial:" VerticalAlignment="Center" Width="95"/>
                                <ComboBox x:Name="CmbCol" SelectionChanged="ParamChanged">
                                    <ComboBoxItem Content="Coluna 1 (Esq.)"/>
                                    <ComboBoxItem Content="Coluna 2"/>
                                    <ComboBoxItem Content="Coluna 3"/>
                                    <ComboBoxItem Content="Coluna 4 (Dir.)"/>
                                </ComboBox>
                            </DockPanel>

                            <TextBlock Text="3. Dimensões do Bloco:" FontWeight="Bold" Margin="0,4,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Largura (Colunas):" VerticalAlignment="Center" Width="95"/>
                                <ComboBox x:Name="CmbColSpan" SelectionChanged="ParamChanged">
                                    <ComboBoxItem Content="1 Coluna"/>
                                    <ComboBoxItem Content="2 Colunas"/>
                                    <ComboBoxItem Content="3 Colunas"/>
                                    <ComboBoxItem Content="4 Colunas (Total)"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Altura (Linhas):" VerticalAlignment="Center" Width="95"/>
                                <ComboBox x:Name="CmbRowSpan" SelectionChanged="ParamChanged">
                                    <ComboBoxItem Content="1 Linha"/>
                                    <ComboBoxItem Content="2 Linhas"/>
                                    <ComboBoxItem Content="3 Linhas"/>
                                    <ComboBoxItem Content="4 Linhas (Total)"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Pré-visualização do Ecrã (4 Linhas x 4 Colunas):" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid x:Name="GridPreview" Background="#060A12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <Button Content="Restaurar Padrão" Click="BtnResetDefault_Click" Style="{DynamicResource NavyButton}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Cancelar" Click="BtnCancel_Click" Style="{DynamicResource NavyButton}" Margin="0,0,8,0"/>
                    <Button Content="Guardar e Aplicar" Click="BtnSave_Click" Style="{DynamicResource GoldButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>